# Copy to .env and source it. Never commit the real file.
#
# IMPORTANT: LEMIEUX_MEDIA_ROOTS is split on os.pathsep — ':' on Linux,
# ';' on Windows. Use the block matching the host you run the harness on.
# Drive-letter paths (K:\dead) MUST use ';' or the colon in the drive letter
# splits the path.

# --- Ollama -------------------------------------------------------------------
# Point at a BASE model. The persona is injected from the Modelfile's SYSTEM
# block at runtime, so no `ollama create` step is needed. Do NOT put a derived
# model name here unless you actually built one.
#
# Cloud:  kimi-k2.7-code:cloud  kimi-k3:cloud
# Local:  qwen3:14b  qwen3:30b  qwen3-coder:30b  gemma4:26b
LEMIEUX_MODEL=qwen3:14b
OLLAMA_HOST=http://localhost:11434
LEMIEUX_MAX_ITERATIONS=12

# Web search for the release watch. This is a SEPARATE credential from
# `ollama signin` — signin authorizes cloud models, this authorizes search.
# Create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Set to 0 ONLY if LEMIEUX_MODEL names a model built with `ollama create`,
# which already carries the prompt — otherwise it gets sent twice.
LEMIEUX_INJECT_SYSTEM=1

# --- Plex ---------------------------------------------------------------------
# Token: sign in to Plex web, open any item's "Get Info" -> "View XML",
# and copy X-Plex-Token from the URL.
PLEX_BASEURL=http://192.168.4.254:32400
PLEX_TOKEN=
PLEX_MACHINE_ID=c389bcb3ea42d137fc4be13eb8aa2afccf991c1a
PLEX_TIMEOUT=30

# --- Release watch ------------------------------------------------------------
# Pipe-separated. These are the catalogs swept for releases not already held.
LEMIEUX_WATCH_ARTISTS=Grateful Dead|Dead|Further|Dead & Company|The Warlocks|Jerry Garcia|Jerry Garcia Band

# Plex sections used to build held inventory. Empty = ALL music sections,
# which is the safe default: a release missing from inventory gets reported as
# a gap you already own. Narrow it only if that proves noisy.
LEMIEUX_INVENTORY_SECTIONS=

# Where the release ledger lives — what has already been reported, so a
# scheduled sweep does not repeat itself. Default: release_ledger.json in the
# project root. Keep it OUT of git; it is per-install state.
LEMIEUX_LEDGER=

# Suppression policy for the release ledger.
#
# "1" (default) = suppress only releases that are now held in Plex; keep
# re-reporting not_held/uncertain releases every sweep until acquired.
# "0" = legacy behavior, only re-report when verdict/status/date changed.
LEMIEUX_LEDGER_SUPPRESS_ONLY_HELD=1

# Seconds to cache the Plex album inventory within a run. Building it walks
# every album in every music section, and a sweep checks holdings once per
# candidate — without caching, each check re-enumerates the whole library.
LEMIEUX_INVENTORY_TTL=600

# --- Notification -------------------------------------------------------------
# Email carries a concise list of not_held releases; SMS carries a short alert
# with the first release's source URL. Carrier gateways mangle long messages.
#
# Gmail requires an APP PASSWORD, not your account password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
LEMIEUX_SMTP_HOST=smtp.gmail.com
LEMIEUX_SMTP_PORT=587
LEMIEUX_SMTP_USER=
LEMIEUX_SMTP_PASSWORD=

LEMIEUX_EMAIL_TO=

# SMS via carrier email gateway: <10-digit-number>@<carrier gateway>.
# Verizon   @vtext.com        T-Mobile  @tmomail.net
# AT&T      @txt.att.net      Google Fi @msg.fi.google.com
# Carriers have been retiring these gateways — if texts stop arriving, the
# gateway is the first suspect, not this code.
LEMIEUX_SMS_TO=

# "findings" (default) sends only when the sweep found something.
# "always" sends every run, including quiet ones.
LEMIEUX_NOTIFY_ON=findings

# --- Web chat -----------------------------------------------------------------
# The web UI runs on the Plex host and is reached over Tailscale/LAN.
# LEMIEUX_WEB_PASSWORD is required; without it the server refuses to start.
LEMIEUX_WEB_HOST=0.0.0.0
LEMIEUX_WEB_PORT=8000
LEMIEUX_WEB_PASSWORD=

# --- Notification formatting --------------------------------------------------
#
# You can customize the plain-text bodies below. Variables available:
#   {count}         number of definite (not_held) new findings
#   {releases}      rendered list of releases
#   {title}         first release title
#   {url}           source URL for a release
#   {status_date}   combined status + date line, e.g. "pre-sale — 2025-11-21"
#   {status}        pre-sale / released / announced / etc. (may be empty)
#   {date}          " — 2025-11-15" if a release date is known, else ""
#   {extra_count}   how many additional releases beyond the first
#
# Only releases with verdict 'not_held' are notified. Uncertain releases are
# committed to the ledger but do not trigger an email or SMS.
LEMIEUX_EMAIL_TEMPLATE="Lemieux found {count} new release(s):\n\n{releases}\n"
LEMIEUX_EMAIL_RELEASE_TEMPLATE="• {title} — {status_date}\n  {url}"
LEMIEUX_SMS_TEMPLATE="Lemieux: {count} new — {title}{more} {url}"
LEMIEUX_SMS_MORE_TEMPLATE=" +{extra_count} more"

# Carrier gateways mangle long messages. Keep this under their limits.
LEMIEUX_SMS_MAX_CHARS=300

# --- Filesystem jail ----------------------------------------------------------
# Nothing outside these roots is readable by any tool.
LEMIEUX_MAX_ROWS=250

# Running ON the Plex box (hal9003, Ubuntu) — colon-separated:
LEMIEUX_MEDIA_ROOTS=/disks/wd:/disks/evo:/disks/media_storage:/home/tim/logs

# Running on Windows against the shares — semicolon-separated, UNC preferred
# over drive letters (mapped drives disappear under a service account):
# LEMIEUX_MEDIA_ROOTS=\\hal9003\media_storage;\\hal9003\evo;\\hal9003\wd
#
# Drive-letter fallback, same separator:
# LEMIEUX_MEDIA_ROOTS=K:\dead;D:\daves_picks
